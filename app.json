{
  "expo": {
    "name": "Calories App",
    "slug": "calories-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caloriesapp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice input to log food entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF6E9"
      },
      "package": "com.caloriesapp",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "calories-app"
      }
    }
  }
}
